# ServiceNow Instance Configuration
# Copy this file to .env and fill in your credentials

# Your ServiceNow instance name (without .service-now.com)
# Example: if your URL is https://dev12345.service-now.com, use dev12345
SERVICENOW_INSTANCE=your-instance-name

# ServiceNow credentials
SERVICENOW_USERNAME=your-username # default is "admin"
SERVICENOW_PASSWORD=your-password